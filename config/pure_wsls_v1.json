  },
  "initial_pi": 0.5,
  "stimulus_kernel": {
    "update_rule": "pi_next_equals_category_exactly_alpha_fixed_at_one_not_a_finite_approximation",
    "learning_rate_parameterization": "alpha_is_the_literal_python_float_1.0_never_a_fitted_coordinate",
    "initial_prior": "pi_1_equals_one_half_every_session",
    "feedback_gate": "update_applied_only_when_feedback_valid_is_true_else_pi_carries_forward_unchanged",
    "prediction_uses_pre_update_pi": true,
    "session_reset": "pi_resets_to_one_half_at_the_start_of_every_session_dynamic_state_never_crosses_a_session_boundary",
    "hidden_state": "none_pi_t_is_itself_the_fitted_scalar_belief_not_a_function_of_a_discrete_state",
    "hazard": "none_this_model_has_no_hazard_or_transition_kernel",
    "sensory_readout": "none_this_model_has_no_duration_dependent_sensory_evidence_of_any_kind",
    "fixed_category_rate_prototypes": "none_this_model_has_no_theta_lookup",
    "interpretation": "pi_t_equals_the_previous_feedback_valid_trials_true_category_exactly_a_literal_win_stay_lose_shift_on_category_rule",
    "category_emission_in_outer_objective": false,
    "true_block_identity_predictive_input": false,
    "true_switch_index_predictive_input": false
  },
  "initialization_table": {
