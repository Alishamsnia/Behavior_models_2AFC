  "software_version": "0.1.0",
  "implemented_scope": "no sensory evidence, no lapse-mixture change: pi_t is a scalar belief updated only from the previous trial's true category, with alpha fixed at exactly 1.0 (a literal win-stay/lose-shift-on-category rule); duration never enters prediction or likelihood eligibility",
  "parameter_order": ["ell_short", "ell_long"],
  "session_policy": "independent_dynamic_episode_reset_to_neutral",
  "source_m0_registry": {
