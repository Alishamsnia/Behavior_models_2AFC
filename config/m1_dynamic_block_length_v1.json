    "neutral_reentry": false,
    "biased_switch_rule": "S_to_L_and_L_to_S_only",
    "within_trial_order": "predict_then_emission_update_then_hsmm_transition",
    "prototype_source": "fixed_true_rates_no_fitted_prototype",
    "true_block_predictive_input": false,
    "true_run_length_predictive_input": false,
