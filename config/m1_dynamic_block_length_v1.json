  "tail_acceptance": {
    "statistic": "mean_pre_choice_tail_probability_across_all_training_timeline_trials",
    "maximum_accepted_value": 0.01,
    "required_for_convergence_and_winner_eligibility": true,
    "rationale": "more_than_one_percent_expected_tail_occupancy_can_materially_identify_bh_from_the_frozen_h65_approximation"
  },
  "initialization_table": {
