  "convergence": {
    "maximum_epochs": 2000,
    "minimum_learning_rate": 1e-06,
    "gradient_norm_tolerance": 1e-05,
    "meaningful_improvement_tolerance": 1e-08,
    "no_improvement_patience_epochs": 100,
    "stable_training_window_epochs": 25,
    "required_checks": [
      "finite_objective",
      "finite_parameters",
      "finite_gradients",
      "small_gradient_norm",
