  "software_version": "0.1.0",
  "implemented_scope": "no sensory evidence: pi_t is a scalar action-history state updated by a delta rule on the mouse's own valid choices with a fitted learning rate alpha=sigmoid(a) (actionHistory_lapse), mixed only with the category-dependent lapse; the action-driven sibling of Extended_WSLS_v1; duration never enters prediction or likelihood eligibility",
  "parameter_order": [
    "ell_short",
    "ell_long",
    "a"
  ],
  "session_policy": "independent_dynamic_episode_reset_to_neutral",
  "source_m0_registry": {
    "file": "config/m0_sensory_v1.json",
    "sha256": "557c5edb6b4085db1717b511587b4658681bc4d2088e311483b5f6a6eb9041d1"
  },
  "initial_pi": 0.5,
  "action_kernel": {
    "update_rule": "pi_next_equals_pi_plus_sigmoid_a_times_choice_long_minus_pi",
    "learning_rate_parameterization": "alpha_equals_sigmoid_a_fitted_open_interval_zero_one_the_alpha_equals_one_boundary_is_pure_action_v1",
    "interpretation": "pi_t_is_an_exponentially_weighted_average_of_the_mouse_own_previous_valid_choices_a_choice_perseveration_state_not_an_environmental_belief",
    "initial_prior": "pi_1_equals_one_half_every_session",
    "update_signal": "choice_long_the_mouse_own_long_short_action_never_the_true_category",
    "update_gate": "update_applied_only_when_choice_long_is_finite_and_binary_independent_of_feedback_valid_category_validity_and_duration_validity_else_pi_carries_forward_unchanged",
    "likelihood_gate": "valid_binary_choice_and_finite_binary_current_category_duration_never_read",
    "prediction_uses_pre_update_pi": true,
    "session_reset": "pi_resets_to_one_half_at_the_start_of_every_session_dynamic_state_never_crosses_a_session_boundary",
    "hidden_state": "none_pi_t_is_itself_the_fitted_scalar_action_history_state_not_a_function_of_a_discrete_state",
    "hazard": "none_this_model_has_no_hazard_or_transition_kernel",
    "sensory_readout": "none_this_model_has_no_duration_dependent_sensory_evidence_of_any_kind",
    "lapse": "category_dependent_ell_short_ell_long_keyed_on_the_true_current_category_identical_to_pure_wsls_v1_and_every_other_model",
    "fixed_category_rate_prototypes": "none_this_model_has_no_theta_lookup",
